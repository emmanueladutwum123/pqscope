# Hardened sshd configuration
Port 22
HostKey /etc/ssh/ssh_host_ed25519_key
KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512@openssh.com,curve25519-sha256,diffie-hellman-group14-sha1
HostKeyAlgorithms ssh-ed25519-cert-v01@openssh.com,ssh-ed25519,rsa-sha2-512,ssh-rsa
Ciphers=chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,3des-cbc
MACs hmac-sha2-256-etm@openssh.com,hmac-sha1
PubkeyAcceptedAlgorithms -ssh-dss
