<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'">
<meta name="generator" content="pqscope {{.ToolVersion}}">
<title>pqscope report</title>
<style>
:root {
  --bg: #ffffff; --fg: #1b1f24; --muted: #59636e; --line: #d1d9e0; --panel: #f6f8fa;
  --broken: #b42318; --vulnerable: #b54708; --weakened: #6941c6; --hybrid: #026aa2; --safe: #067647;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0d1117; --fg: #e6edf3; --muted: #9198a1; --line: #3d444d; --panel: #151b23;
    --broken: #ff7b72; --vulnerable: #f0b72f; --weakened: #bc8cff; --hybrid: #58a6ff; --safe: #56d364;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--fg);
  font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
main { max-width: 1200px; margin: 0 auto; padding: 24px 16px 48px; }
h1 { font-size: 22px; margin: 0 0 4px; }
h2 { font-size: 17px; margin: 32px 0 8px; }
.meta { color: var(--muted); margin: 0; }
.cards { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
.card { border: 1px solid var(--line); border-radius: 8px; padding: 10px 14px; min-width: 120px; background: var(--panel); }
.card b { display: block; font-size: 22px; }
.wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; }
table { border-collapse: collapse; width: 100%; }
th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
th { background: var(--panel); font-weight: 600; white-space: nowrap; }
tr:last-child td { border-bottom: 0; }
td.num { text-align: right; font-variant-numeric: tabular-nums; }
code { font: 12px/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; word-break: break-all; }
.q { font-weight: 600; white-space: nowrap; }
.q-broken-now { color: var(--broken); } .q-vulnerable { color: var(--vulnerable); }
.q-weakened { color: var(--weakened); } .q-hybrid { color: var(--hybrid); } .q-safe { color: var(--safe); }
.filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
input, select { font: inherit; color: var(--fg); background: var(--bg); border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; }
input { flex: 1 1 240px; }
.empty { color: var(--muted); }
footer { color: var(--muted); margin-top: 32px; font-size: 12px; }
</style>
</head>
<body>
<main>
<h1>pqscope report</h1>
<p class="meta">{{if .Target}}Target <code>{{.Target}}</code> · {{end}}{{.SummaryLine}} · generated {{.Generated}}</p>

<div class="cards">
  <div class="card"><b>{{len .Findings}}</b>findings</div>
  {{range .Counts}}<div class="card"><b class="q q-{{.Status}}">{{.Count}}</b>{{.Status}}</div>
  {{end}}
</div>

{{if .Findings}}
<h2>Assets</h2>
<div class="wrap"><table>
<thead><tr><th>Asset</th><th>Primitive</th><th>Quantum status</th><th>Findings</th><th>Migrate to</th></tr></thead>
<tbody>
{{range .Groups}}<tr><td>{{.Name}}</td><td>{{.Primitive}}</td><td class="q q-{{.Quantum}}">{{.Quantum}}</td><td class="num">{{.Count}}</td><td>{{if .Migration}}{{.Migration}}{{else}}<span class="empty">none needed</span>{{end}}</td></tr>
{{end}}
</tbody></table></div>

<h2>Findings</h2>
<div class="filters">
  <input id="filter" type="search" placeholder="Filter by path, algorithm or rule" aria-label="Filter findings">
  <select id="status" aria-label="Quantum status">
    <option value="">All statuses</option>
    {{range .Counts}}<option value="{{.Status}}">{{.Status}}</option>{{end}}
  </select>
</div>
<div class="wrap"><table id="findings">
<thead><tr><th>Location</th><th>Algorithm</th><th>Params</th><th>Primitive</th><th>Quantum status</th><th>Confidence</th><th>Rule</th><th>Evidence</th></tr></thead>
<tbody>
{{range .Rows}}<tr data-q="{{.Quantum}}"><td><code>{{.Location}}</code></td><td>{{.Algorithm}}</td><td>{{.Params}}</td><td>{{.Primitive}}</td><td class="q q-{{.Quantum}}">{{.Quantum}}</td><td class="num">{{.Confidence}}</td><td><code>{{.Rule}}</code></td><td><code>{{.Evidence}}</code></td></tr>
{{end}}
</tbody></table></div>
{{else}}
<p class="empty">No cryptographic assets found.</p>
{{end}}

<footer>Generated by pqscope {{.ToolVersion}}. Only the layers implemented in this version were scanned; an empty section is not evidence that a system is free of quantum-vulnerable cryptography.</footer>
</main>
<script>
(function () {
  var text = document.getElementById("filter"), status = document.getElementById("status");
  if (!text) return;
  var rows = document.querySelectorAll("#findings tbody tr");
  function apply() {
    var t = text.value.toLowerCase(), s = status.value;
    rows.forEach(function (r) {
      var show = (!s || r.dataset.q === s) && (!t || r.textContent.toLowerCase().indexOf(t) >= 0);
      r.hidden = !show;
    });
  }
  text.addEventListener("input", apply);
  status.addEventListener("change", apply);
})();
</script>
</body>
</html>
